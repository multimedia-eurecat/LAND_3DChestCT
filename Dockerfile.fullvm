FROM ubuntu:24.04

ARG NVIDIA_DRIVER_PACKAGE=nvidia-driver-580-open

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/opt/app/src \
    LAND_PYTHON=/opt/venv/bin/python3 \
    MPLCONFIGDIR=/tmp/matplotlib \
    USE_TF=0 \
    LAND_MODEL_PATH=/opt/app/data/ckpts/2025-09-10_17-51-07_256_bsz1_lr1e-5_nodule+lung_mask \
    LAND_MASK_DATASET=/opt/app/data/masks \
    LAND_OUTPUTS_DIR=/opt/app/web_outputs

RUN apt-get update && apt-get install -y --no-install-recommends \
        systemd systemd-sysv cloud-init initramfs-tools linux-generic \
        build-essential dkms "$NVIDIA_DRIVER_PACKAGE" \
        python3 python3-pip python3-venv ca-certificates curl libgomp1 \
        nginx openssh-server pciutils kmod mount \
    && echo 'options nvidia_uvm uvm_disable_hmm=1' > /etc/modprobe.d/nvidia-uvm-land.conf \
    && echo fs-virtiofs >> /etc/initramfs-tools/modules \
    && update-initramfs -c -k all \
    && rm -f /etc/nginx/sites-enabled/default \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/app
COPY requirements-inference.txt .
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/python3 -m pip install --no-cache-dir --timeout 120 --retries 10 \
        --index-url https://pypi.org/simple pip==25.2 \
    && /opt/venv/bin/python3 -m pip install --no-cache-dir --timeout 120 --retries 10 \
        --resume-retries 10 --index-url https://pypi.org/simple \
        --find-links https://download.pytorch.org/whl/cu128/torch/ \
        --find-links https://download.pytorch.org/whl/cu128/torchvision/ \
        torch==2.7.0+cu128 torchvision==0.22.0+cu128 \
    && /opt/venv/bin/python3 -m pip install --no-cache-dir --timeout 120 --retries 10 \
        --resume-retries 10 --index-url https://pypi.org/simple \
        -r requirements-inference.txt \
    && /opt/venv/bin/python3 -m pip check \
    && /opt/venv/bin/python3 -c "import torch, torchvision; assert torch.__version__ == '2.7.0+cu128'; assert torchvision.__version__ == '0.22.0+cu128'"

COPY src ./src
COPY LICENSE NOTICE ./
COPY data/ckpts/2025-09-10_17-51-07_256_bsz1_lr1e-5_nodule+lung_mask/ ./data/ckpts/2025-09-10_17-51-07_256_bsz1_lr1e-5_nodule+lung_mask/
COPY data/masks/ ./data/masks/
COPY nginx/default.conf /etc/nginx/sites-enabled/default
COPY scripts/gpu-setup.sh /usr/local/bin/gpu-setup.sh
COPY scripts/land-app.sh /usr/local/bin/land-app.sh
COPY scripts/nginx-run.sh /usr/local/bin/nginx-run.sh
COPY scripts/sshd-run.sh /usr/local/bin/sshd-run.sh
COPY scripts/fullvm-runtime-env.sh /usr/local/bin/fullvm-runtime-env.sh
COPY scripts/land-runtime-env.sh /usr/local/lib/land-runtime-env.sh
COPY systemd/*.service /etc/systemd/system/

RUN chmod +x /usr/local/bin/gpu-setup.sh /usr/local/bin/land-app.sh \
        /usr/local/bin/nginx-run.sh /usr/local/bin/sshd-run.sh \
        /usr/local/bin/fullvm-runtime-env.sh \
    && (systemctl disable nginx.service ssh.service ssh.socket 2>/dev/null || true) \
    && (systemctl mask ssh.service ssh.socket 2>/dev/null || true) \
    && systemctl enable land-runtime-env.service land-gpu-setup.service \
        land-sshd.service land-app.service land-nginx.service \
    && apt-get update \
    && apt-get install -y --no-install-recommends file \
    && kernel_path="$(find /boot -maxdepth 1 -type f -name 'vmlinuz-*' | sort -V | tail -n 1)" \
    && test -n "$kernel_path" \
    && curl -fsSL https://raw.githubusercontent.com/torvalds/linux/master/scripts/extract-vmlinux \
        -o /usr/local/bin/extract-vmlinux \
    && chmod +x /usr/local/bin/extract-vmlinux \
    && /usr/local/bin/extract-vmlinux "$kernel_path" > "$kernel_path.elf" \
    && test -s "$kernel_path.elf" \
    && mv "$kernel_path.elf" "$kernel_path" \
    && kernel_version="$(basename "$kernel_path" | sed 's/^vmlinuz-//')" \
    && initrd_path="/boot/initrd.img-$kernel_version" \
    && test -f "$initrd_path" \
    && rm -f /boot/vmlinuz /boot/initrd.img \
    && cp "$kernel_path" /boot/vmlinuz \
    && cp "$initrd_path" /boot/initrd.img \
    && test -f /boot/vmlinuz \
    && test -f /boot/initrd.img \
    && test -d "/lib/modules/$kernel_version" \
    && rm -rf /var/lib/apt/lists/*

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
